DB_URL=jdbc:postgresql://localhost:5433/ram
DB_USERNAME=ram
DB_PASSWORD=change-me-for-non-dev
JWT_SECRET=change-me-to-at-least-32-bytes-before-use
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=false
ATTACHMENTS_STORAGE_ROOT=storage/attachments
ATTACHMENTS_MAX_FILE_SIZE=25MB
ATTACHMENTS_MAX_REQUEST_SIZE=500MB
ATTACHMENTS_MAX_FILES_PER_REQUEST=20
ATTACHMENTS_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,text/plain,text/csv,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip,application/octet-stream
ATTACHMENTS_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv,doc,docx,xls,xlsx,zip
